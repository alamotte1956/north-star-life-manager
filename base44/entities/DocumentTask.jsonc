{
  "name": "DocumentTask",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID of the family"
    },
    "document_id": {
      "type": "string",
      "description": "Related document ID"
    },
    "document_title": {
      "type": "string",
      "description": "Document title for display"
    },
    "task_title": {
      "type": "string",
      "description": "Task title"
    },
    "task_description": {
      "type": "string",
      "description": "Task description"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Assigned family member email"
    },
    "assigned_by_email": {
      "type": "string",
      "description": "Who assigned the task"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Task due date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "family_id",
    "task_title",
    "assigned_to_email"
  ]
}