{
  "name": "Contract",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "contract_title": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "service_agreement",
        "nda",
        "sow",
        "retainer",
        "consulting",
        "custom"
      ],
      "description": "Contract template type"
    },
    "contract_value": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "active",
        "expired",
        "terminated"
      ],
      "default": "draft"
    },
    "template_data": {
      "type": "object",
      "description": "Template variables and content"
    },
    "contract_content": {
      "type": "string",
      "description": "Full contract text"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "unsigned",
        "partially_signed",
        "fully_signed"
      ],
      "default": "unsigned"
    },
    "client_signature_date": {
      "type": "string",
      "format": "date-time"
    },
    "provider_signature_date": {
      "type": "string",
      "format": "date-time"
    },
    "signed_document_url": {
      "type": "string"
    },
    "auto_renew": {
      "type": "boolean",
      "default": false
    },
    "renewal_notification_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "contract_title",
    "contract_type"
  ]
}