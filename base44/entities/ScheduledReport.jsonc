{
  "name": "ScheduledReport",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Report owner"
    },
    "report_name": {
      "type": "string",
      "description": "Report name"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "monthly_spending",
        "investment_performance",
        "succession_documents",
        "property_analytics",
        "budget_summary",
        "tax_summary",
        "custom"
      ],
      "description": "Type of report"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annual"
      ],
      "default": "monthly",
      "description": "How often to generate"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses to send to"
    },
    "format": {
      "type": "string",
      "enum": [
        "pdf",
        "csv",
        "excel"
      ],
      "default": "pdf",
      "description": "Export format"
    },
    "parameters": {
      "type": "object",
      "description": "Report-specific parameters"
    },
    "next_run_date": {
      "type": "string",
      "format": "date-time",
      "description": "When to generate next"
    },
    "last_run_date": {
      "type": "string",
      "format": "date-time",
      "description": "When last generated"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether schedule is active"
    }
  },
  "required": [
    "report_name",
    "report_type",
    "frequency"
  ]
}