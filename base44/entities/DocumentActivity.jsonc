{
  "name": "DocumentActivity",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID of the document"
    },
    "document_title": {
      "type": "string",
      "description": "Document title for display"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "upload",
        "view",
        "edit",
        "download",
        "share",
        "comment",
        "version_upload"
      ],
      "description": "Type of activity"
    },
    "user_email": {
      "type": "string",
      "description": "User who performed the activity"
    },
    "user_name": {
      "type": "string",
      "description": "User's full name"
    },
    "family_id": {
      "type": "string",
      "description": "Family ID"
    },
    "metadata": {
      "type": "object",
      "description": "Additional activity details"
    }
  },
  "required": [
    "document_id",
    "activity_type",
    "user_email"
  ]
}