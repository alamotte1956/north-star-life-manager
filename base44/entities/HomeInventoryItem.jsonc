{
  "name": "HomeInventoryItem",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "property_id": {
      "type": "string",
      "description": "Related property"
    },
    "property_name": {
      "type": "string"
    },
    "room": {
      "type": "string",
      "description": "Room location"
    },
    "item_name": {
      "type": "string",
      "description": "Item name"
    },
    "category": {
      "type": "string",
      "enum": [
        "electronics",
        "furniture",
        "appliances",
        "jewelry",
        "art",
        "collectibles",
        "clothing",
        "tools",
        "sports",
        "other"
      ],
      "description": "Item category"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "current_value": {
      "type": "number",
      "description": "Estimated current value"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item photos"
    },
    "receipt_document_id": {
      "type": "string"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "insured": {
      "type": "boolean",
      "default": false
    },
    "ai_detected": {
      "type": "boolean",
      "default": false,
      "description": "Detected via computer vision"
    },
    "ai_confidence": {
      "type": "number",
      "description": "Detection confidence"
    }
  },
  "required": [
    "item_name",
    "category"
  ]
}