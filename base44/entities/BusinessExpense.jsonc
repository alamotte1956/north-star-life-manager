{
  "name": "BusinessExpense",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "expense_date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "software",
        "travel",
        "meals",
        "professional_services",
        "office",
        "marketing",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "vendor": {
      "type": "string"
    },
    "billable": {
      "type": "boolean",
      "default": false
    },
    "invoiced": {
      "type": "boolean",
      "default": false
    },
    "invoice_id": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "tax_deductible": {
      "type": "boolean",
      "default": true
    },
    "synced_to_accounting": {
      "type": "boolean",
      "default": false
    },
    "transaction_id": {
      "type": "string",
      "description": "Link to Transaction entity"
    }
  },
  "required": [
    "expense_date",
    "category",
    "description",
    "amount"
  ]
}