{
  "name": "LeaseRenewal",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "ID of the property"
    },
    "property_name": {
      "type": "string",
      "description": "Property name"
    },
    "tenant_email": {
      "type": "string",
      "description": "Current tenant email"
    },
    "tenant_name": {
      "type": "string",
      "description": "Current tenant name"
    },
    "current_lease_end_date": {
      "type": "string",
      "format": "date",
      "description": "Current lease expiration date"
    },
    "current_monthly_rent": {
      "type": "number",
      "description": "Current rent amount"
    },
    "proposed_lease_start_date": {
      "type": "string",
      "format": "date",
      "description": "Proposed new lease start date"
    },
    "proposed_lease_end_date": {
      "type": "string",
      "format": "date",
      "description": "Proposed new lease end date"
    },
    "proposed_monthly_rent": {
      "type": "number",
      "description": "Proposed new rent amount"
    },
    "market_rate_analysis": {
      "type": "string",
      "description": "AI-generated market analysis"
    },
    "rent_adjustment_percentage": {
      "type": "number",
      "description": "Percentage change from current rent"
    },
    "renewal_terms": {
      "type": "string",
      "description": "Terms and conditions of renewal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired",
        "completed"
      ],
      "default": "pending",
      "description": "Renewal offer status"
    },
    "tenant_response_date": {
      "type": "string",
      "format": "date-time",
      "description": "When tenant responded"
    },
    "tenant_notes": {
      "type": "string",
      "description": "Tenant's comments on the renewal"
    },
    "generated_lease_document_id": {
      "type": "string",
      "description": "ID of generated lease document"
    },
    "expires_on": {
      "type": "string",
      "format": "date",
      "description": "When this renewal offer expires"
    }
  },
  "required": [
    "property_id",
    "tenant_email",
    "current_lease_end_date",
    "proposed_monthly_rent"
  ]
}