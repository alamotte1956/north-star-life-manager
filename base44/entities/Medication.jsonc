{
  "name": "Medication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Medication name"
    },
    "dosage": {
      "type": "string",
      "description": "Dosage (e.g., 10mg, 500mg)"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once_daily",
        "twice_daily",
        "three_times_daily",
        "four_times_daily",
        "as_needed",
        "weekly",
        "monthly"
      ],
      "description": "How often to take medication"
    },
    "time_of_day": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific times to take medication (e.g., 08:00, 20:00)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "When medication started"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "When medication ends (if applicable)"
    },
    "prescribing_doctor": {
      "type": "string",
      "description": "Doctor who prescribed"
    },
    "purpose": {
      "type": "string",
      "description": "What the medication is for"
    },
    "side_effects": {
      "type": "string",
      "description": "Known or experienced side effects"
    },
    "refill_reminder_days": {
      "type": "number",
      "default": 7,
      "description": "Days before running out to send refill reminder"
    },
    "quantity_remaining": {
      "type": "number",
      "description": "Pills/doses remaining"
    },
    "last_taken": {
      "type": "string",
      "format": "date-time",
      "description": "Last time medication was taken"
    },
    "adherence_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "taken": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Log of medication adherence"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether medication is currently active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "dosage",
    "frequency"
  ]
}