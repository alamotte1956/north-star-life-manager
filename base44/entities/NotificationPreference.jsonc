{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "document_expiry_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about document expiry"
    },
    "document_expiry_days_before": {
      "type": "number",
      "default": 30,
      "description": "Days before expiry to notify"
    },
    "maintenance_due_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about maintenance due"
    },
    "maintenance_due_days_before": {
      "type": "number",
      "default": 7,
      "description": "Days before maintenance due to notify"
    },
    "bill_due_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about bills due"
    },
    "bill_due_days_before": {
      "type": "number",
      "default": 3,
      "description": "Days before bill due to notify"
    },
    "subscription_renewal_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about subscription renewals"
    },
    "subscription_renewal_days_before": {
      "type": "number",
      "default": 7,
      "description": "Days before subscription renewal to notify"
    },
    "lease_expiring_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about lease expirations"
    },
    "lease_expiring_days_before": {
      "type": "number",
      "default": 60,
      "description": "Days before lease expires to notify"
    },
    "policy_renewal_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about insurance policy renewals"
    },
    "policy_renewal_days_before": {
      "type": "number",
      "default": 30,
      "description": "Days before policy renewal to notify"
    },
    "medication_refill_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Notify about medication refills"
    },
    "medication_refill_days_before": {
      "type": "number",
      "default": 5,
      "description": "Days before medication runs out to notify"
    },
    "in_app_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show in-app notifications"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Send email notifications"
    },
    "push_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Send push notifications"
    },
    "reminder_time": {
      "type": "string",
      "default": "09:00",
      "description": "Preferred time for reminders (HH:MM format)"
    }
  },
  "required": [
    "user_email"
  ]
}